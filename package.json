{
  "name": "petanque-draw",
  "version": "1.16.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "lint:eslint": "eslint .",
    "lint": "npm run lint:eslint && npm run stylelint && npm run format:check",
    "format": "prettier . --write --log-level warn",
    "format:check": "prettier . --check --log-level warn",
    "stylelint": "stylelint \"src/**/*.{vue,css}\"",
    "stylelint:fix": "stylelint \"src/**/*.{vue,css}\" --fix",
    "lint:fix": "eslint . --fix && npm run stylelint:fix && prettier . --write --log-level warn",
    "e2e": "npx playwright test",
    "e2e:ui": "npx playwright test --ui",
    "e2e:headed": "npx playwright test --headed"
  },
  "dependencies": {
    "@vuepic/vue-datepicker": "^10.0.0",
    "apexcharts": "^5.11.0",
    "firebase": "^12.13.0",
    "html2pdf.js": "^0.14.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "qrcode.vue": "^3.3.3",
    "vue": "^3.5.34",
    "vue-i18n": "^11.4.0",
    "vue-router": "^5.0.6",
    "vue3-apexcharts": "1.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@stylistic/stylelint-plugin": "^5.1.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.1",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.3",
    "stylelint": "^17.11.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.0.11",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.5",
    "vue-eslint-parser": "^10.4.0",
    "vue3-select-component": "^0.16.2"
  }
}
